# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.

# Токен доступа к веб-интерфейсу (любая длинная случайная строка)
APP_TOKEN=замените-на-длинную-случайную-строку

# Ключ Finnhub (бесплатный, finnhub.io) — котировки и поиск по Nasdaq
FINNHUB_KEY=

# Ключ Twelve Data (бесплатный, twelvedata.com) — свечи США
TWELVEDATA_KEY=

# Telegram: токен бота от @BotFather и chat_id владельца
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Порт веб-сервера (туннель Cloudflare/Tailscale смотрит сюда)
PORT=8800

# Путь к базе SQLite
DB_PATH=data/informer.db

# Папка для ежедневных копий БД (лучше на другом диске или в папке OneDrive/Яндекс Диска)
BACKUP_DIR=

# Публичный адрес туннеля — для ссылок «Открыть карточку» в Telegram, например https://informer.example.com
PUBLIC_URL=
